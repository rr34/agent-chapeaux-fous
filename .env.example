# Copy this file to .env in this directory. The server loads it automatically.

# Recommended multimodal connection: direct OpenAI Responses API.
# Create an API project/key, enable API billing, and restart after changing this.
# This key stays on the server; never expose it to the browser or commit .env.
OPENAI_API_KEY=
SLAYER_OPENAI_BASE_URL=https://api.openai.com/v1
SLAYER_OPENAI_TIMEOUT_MS=600000
SLAYER_OPENAI_CONTEXT_WINDOW_TOKENS=1050000
# original preserves small receipt text; high/low reduce image tokens if desired.
SLAYER_OPENAI_IMAGE_DETAIL=original
SLAYER_MODEL=gpt-5.6-terra
# The structured workflow varies effort by phase. The main value remains the
# execution effort and is also the repair fallback.
SLAYER_REASONING_EFFORT=high
SLAYER_ORIENTATION_REASONING_EFFORT=medium
SLAYER_AUDIT_REASONING_EFFORT=low
# SLAYER_REPAIR_REASONING_EFFORT=high
# Emergency rollback only; the structured workflow is enabled by default.
# SLAYER_TURN_WORKFLOW_ENABLED=false

# Estimated API prices in USD per one million tokens. These are the defaults on
# the AI Usage page, where they can be changed locally without altering history.
SLAYER_AI_INPUT_COST_PER_MILLION=2
SLAYER_AI_CACHED_INPUT_COST_PER_MILLION=0.2
SLAYER_AI_CACHE_WRITE_COST_PER_MILLION=2.5
SLAYER_AI_OUTPUT_COST_PER_MILLION=12

SLAYER_VIDEO_MODEL=gpt-5.6-sol
SLAYER_VIDEO_REASONING_EFFORT=high
# Videos are stored under the main media root so authenticated downloads can serve them.
SLAYER_VIDEO_OUTPUT_ROOT=media/videos
# Server narration is AI-generated and is disclosed in the interface and MP4.
SLAYER_TTS_MODEL=gpt-4o-mini-tts
SLAYER_TTS_AGENT_VOICE=verse
SLAYER_TTS_USER_VOICE=shimmer
SLAYER_TTS_AGENT_INSTRUCTIONS=Be an energetic American guy bantering with a friend. Talk extremely fast, around 1.3 times normal conversational speed, with almost no dead air, dramatic pauses, or slow emphasis. Stay animated, mischievous, loose, and intelligible. Never sound like an announcer, presenter, tutorial, corporate demo, audiobook, or polished sales pitch. Pronounce Chapeaux Fou in French as shah-POH FOO, with no final S sound. Speak the supplied words verbatim.
SLAYER_TTS_USER_INSTRUCTIONS=Be a quick-witted Parisian woman speaking English with an unmistakably strong native French accent in every sentence. Use French R sounds, rounded vowels, and French rhythm while staying easy to understand. Talk extremely fast, around 1.3 times normal conversational speed, with almost no dead air, dramatic pauses, or slow emphasis. Stay animated, warm, cheeky, and intelligible. Never sound like an announcer, presenter, tutorial, corporate demo, audiobook, or polished sales pitch. Pronounce Chapeaux Fou as shah-POH FOO, with no final S sound. Speak the supplied words verbatim.
SLAYER_TTS_TIMEOUT_MS=120000
# Optional explicit browser used by the background Remotion worker.
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
# Emergency loop ceiling. Native batch tools should handle large jobs in a few calls.
SLAYER_MAX_TOOL_CALLS=128
# Start a fresh native model thread after the prior turn reaches this percentage
# of its reported context window. The replacement receives a bounded checkpoint
# of user/assistant intent and a compact index of exact ledger receipts.
SLAYER_CONTEXT_ROLLOVER_PERCENT=65
SLAYER_CONVERSATION_CHECKPOINT_CHARACTERS=49152
# Oversized tool results stay exact in SQLite; the live model exchange receives
# this many characters plus a receipt cursor for paginated retrieval.
SLAYER_MAX_INLINE_TOOL_RESULT_CHARACTERS=32768
# Full CSV/vCard/text files use a smaller first-request preview while native
# tools can process the verified whole file. Images are sent as visual input.
SLAYER_MAX_TEXT_ATTACHMENT_BYTES=10485760
SLAYER_MAX_ATTACHMENT_CONTEXT_CHARACTERS=65536
# Generous operational ceiling for one image or document. Raise as needed; this
# protects process memory and is not intended as a product allowance.
SLAYER_MAX_REQUEST_ATTACHMENT_BYTES=52428800

# Explicit-page reader. This does not enable web search.
SLAYER_WEB_PAGE_TIMEOUT_MS=15000
SLAYER_WEB_PAGE_MAX_BYTES=2097152

# Web access. Use a separate long random value.
SLAYER_ACCESS_TOKEN=replace-with-a-long-random-token
SLAYER_HOST=127.0.0.1
SLAYER_PORT=8787
# Browser-visible origin used for MCP OAuth callbacks. Set this to the public
# HTTPS origin when Agent Slayer runs behind a reverse proxy. A path is not
# supported; HTTP is accepted only for a loopback origin.
SLAYER_PUBLIC_URL=http://127.0.0.1:8787
# SLAYER_ALLOW_UNAUTHENTICATED=true

# Local paths. Relative values resolve from this repository.
SLAYER_DATABASE=data/agent.sqlite
SLAYER_MEDIA_ROOT=media
SLAYER_MCP_CONFIG=config/mcp-servers.json
# OAuth client registrations and tokens default to
# ~/.local/state/agent-slayer/mcp-oauth. Override only when necessary.
# SLAYER_MCP_OAUTH_ROOT=/secure/path/to/agent-slayer-mcp-oauth

# Static remote-tool credentials. OAuth integrations do not need access tokens
# here; connect each one from the Agent Slayer web interface.
GITHUB_MCP_PAT=replace-with-a-read-only-github-token

# Native JMAP email. Fastmail's session resource is shown; other conforming
# providers can supply their own. Create a JMAP API token, not an app password.
SLAYER_JMAP_SESSION_URL=https://api.fastmail.com/jmap/session
SLAYER_JMAP_ACCESS_TOKEN=replace-with-a-jmap-api-token
# Optional explicit account; otherwise JMAP's primary mail account is used.
# SLAYER_JMAP_ACCOUNT_ID=
# Fail health and reject agent requests when configured email is unavailable.
SLAYER_JMAP_REQUIRED=true
SLAYER_JMAP_TIMEOUT_MS=15000

# Local faster-whisper transcription.
SLAYER_WHISPER_MODEL=base.en
SLAYER_WHISPER_DEVICE=cpu
SLAYER_WHISPER_COMPUTE_TYPE=int8
SLAYER_PYTHON=voice/.venv/bin/python
HF_HOME=voice/models/huggingface
SLAYER_WHISPER_TIMEOUT_MS=600000

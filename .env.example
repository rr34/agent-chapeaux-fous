# Copy this file to .env in this directory. The server loads it automatically.

# Direct model connection.
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
SLAYER_MODEL=gpt-5.6-terra
SLAYER_REASONING_EFFORT=none
SLAYER_MAX_TOOL_ROUNDS=12

# Web access. Use a separate long random value.
SLAYER_ACCESS_TOKEN=replace-with-a-long-random-token
SLAYER_HOST=127.0.0.1
SLAYER_PORT=8787
# SLAYER_ALLOW_UNAUTHENTICATED=true

# Local paths. Relative values resolve from this repository.
SLAYER_DATABASE=data/agent.sqlite
SLAYER_MEDIA_ROOT=media
SLAYER_PROFILE=config/profile.md
SLAYER_MCP_CONFIG=config/mcp-servers.json

# Remote tool credentials. Leave an integration disabled in config until its
# credential is available. Access tokens belong here; never commit .env.
TLOM_ACCESS_TOKEN=replace-with-a-tlom-access-token
NUTRITION_ACCESS_TOKEN=replace-with-a-nutrition-access-token
GITHUB_MCP_PAT=replace-with-a-read-only-github-token
FASTMAIL_MCP_TOKEN=replace-with-a-fastmail-mcp-token

# Local faster-whisper transcription.
SLAYER_WHISPER_MODEL=base.en
SLAYER_WHISPER_DEVICE=cpu
SLAYER_WHISPER_COMPUTE_TYPE=int8
SLAYER_PYTHON=voice/.venv/bin/python
HF_HOME=voice/models/huggingface
SLAYER_WHISPER_TIMEOUT_MS=600000

{
  "name": "time-v3-technology-agent-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:build:debug": "cd android && ./gradlew :app:assembleDebug",
    "phone:pair": "node scripts/android-device.mjs pair",
    "phone:connect": "node scripts/android-device.mjs connect",
    "phone:install": "node scripts/android-device.mjs install",
    "phone:inspect": "node scripts/android-device.mjs inspect",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}

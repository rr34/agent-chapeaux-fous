{
  "expo": {
    "name": "Time v3 Agent",
    "slug": "chapeaux-fous",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chapeauxfous",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chapeauxfous.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Time v3 Agent records voice requests that you explicitly submit to your agent."
      }
    },
    "android": {
      "package": "com.chapeauxfous.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Time v3 Agent to record voice requests you explicitly submit."
        }
      ],
      "expo-asset"
    ]
  }
}

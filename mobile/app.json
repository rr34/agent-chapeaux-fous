{
  "expo": {
    "name": "Time V3 Technology Agent",
    "slug": "time-v3-technology-agent",
    "version": "0.1.0",
    "icon": "../public/brand/icon-master-1024-opaque.png",
    "orientation": "portrait",
    "scheme": "timev3technologyagent",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timev3.technologyagent",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Time V3 Technology Agent records voice requests that you explicitly submit to your agent."
      }
    },
    "android": {
      "package": "com.timev3.technologyagent",
      "adaptiveIcon": {
        "foregroundImage": "../public/brand/android-adaptive-foreground-1024-transparent.png",
        "backgroundColor": "#0e001e"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_SMS"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Time V3 Technology Agent to record voice requests you explicitly submit.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ]
  }
}

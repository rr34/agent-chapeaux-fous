{
  "expo": {
    "name": "Time V3 Technology Agent",
    "slug": "time-v3-technology-agent",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "timev3technologyagent",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timev3.technologyagent",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Time V3 Technology Agent records voice requests that you explicitly submit to your agent."
      }
    },
    "android": {
      "package": "com.timev3.technologyagent",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Time V3 Technology Agent to record voice requests you explicitly submit."
        }
      ],
      "expo-asset"
    ]
  }
}

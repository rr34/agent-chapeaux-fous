[Unit]
Description=Time v3 Node 20x4 appliance
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=timev3
Group=timev3
EnvironmentFile=/etc/time-v3-node.env
WorkingDirectory=/opt/time-v3-node
ExecStart=/opt/time-v3-node/.venv/bin/time-v3-node
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target


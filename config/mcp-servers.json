{
  "tlom": {
    "enabled": true,
    "required": true,
    "url": "https://mytlom.com/api/mcp",
    "headers": {
      "Authorization": "Bearer ${TLOM_ACCESS_TOKEN}"
    }
  },
  "weather": {
    "enabled": true,
    "url": "https://open-meteo.caseyjhand.com/mcp",
    "includeTools": [
      "openmeteo_search_locations",
      "openmeteo_get_forecast"
    ]
  },
  "github": {
    "enabled": false,
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_MCP_PAT}",
      "X-MCP-Toolsets": "context,repos,issues,pull_requests",
      "X-MCP-Readonly": "true"
    }
  }
}

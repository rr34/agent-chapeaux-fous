{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-slayer.local/schemas/capability-manifest.v1.schema.json",
  "title": "Agent Slayer capability manifest",
  "description": "The authoritative package manifest for one native capability family. The sibling guidance file coordinates its tools but cannot redefine their contracts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../protocol-schemas/capability-manifest.v1.schema.json"
    },
    "protocol": {
      "type": "string",
      "const": "agent-slayer.capability"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "guidance": {
      "type": "string",
      "const": "guidance.md"
    },
    "readOnlyTools": {
      "$ref": "#/$defs/toolNames"
    },
    "dependentTools": {
      "$ref": "#/$defs/toolNames"
    },
    "attachmentHints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extensions": { "$ref": "#/$defs/hintTerms" },
          "mimeIncludes": { "$ref": "#/$defs/hintTerms" },
          "headerTerms": { "$ref": "#/$defs/hintTerms" }
        },
        "anyOf": [
          { "required": ["extensions"] },
          { "required": ["mimeIncludes"] },
          { "required": ["headerTerms"] }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "protocol",
    "version",
    "id",
    "title",
    "summary",
    "aliases",
    "guidance"
  ],
  "$defs": {
    "toolNames": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 120
      }
    },
    "hintTerms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  }
}

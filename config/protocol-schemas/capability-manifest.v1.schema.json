{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-slayer.local/schemas/capability-manifest.v1.schema.json",
  "title": "Agent Slayer capability manifest",
  "description": "The authoritative package manifest for one native capability family, including exhaustive resource lifecycles when the capability owns native data. The sibling guidance file coordinates its tools but cannot redefine their contracts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../protocol-schemas/capability-manifest.v1.schema.json"
    },
    "protocol": {
      "type": "string",
      "const": "agent-slayer.capability"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "guidance": {
      "type": "string",
      "const": "guidance.md"
    },
    "readOnlyTools": {
      "$ref": "#/$defs/toolNames"
    },
    "dependentTools": {
      "$ref": "#/$defs/toolNames"
    },
    "attachmentHints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extensions": { "$ref": "#/$defs/hintTerms" },
          "mimeIncludes": { "$ref": "#/$defs/hintTerms" },
          "headerTerms": { "$ref": "#/$defs/hintTerms" }
        },
        "anyOf": [
          { "required": ["extensions"] },
          { "required": ["mimeIncludes"] },
          { "required": ["headerTerms"] }
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "required": [
    "$schema",
    "protocol",
    "version",
    "id",
    "title",
    "summary",
    "aliases",
    "guidance"
  ],
  "$defs": {
    "toolNames": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 120
      }
    },
    "hintTerms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$", "maxLength": 160 },
        "kind": { "type": "string", "enum": ["object", "relationship"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "management": { "type": "string", "enum": ["user", "system", "provider"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 120 }
          },
          "required": ["table"]
        },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$", "maxLength": 160 }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "$ref": "#/$defs/resourceOperation" },
            "read": { "$ref": "#/$defs/resourceOperation" },
            "update": { "$ref": "#/$defs/resourceOperation" },
            "delete": { "$ref": "#/$defs/resourceOperation" },
            "link": { "$ref": "#/$defs/resourceOperation" },
            "unlink": { "$ref": "#/$defs/resourceOperation" }
          }
        }
      },
      "required": ["id", "kind", "management"],
      "allOf": [
        {
          "if": { "properties": { "management": { "const": "user" } }, "required": ["management"] },
          "then": { "required": ["operations"] },
          "else": { "required": ["reason"] }
        },
        {
          "if": { "properties": { "kind": { "const": "object" } }, "required": ["kind"] },
          "then": { "properties": { "operations": { "type": "object", "required": ["create", "read", "update", "delete"] } } },
          "else": {
            "required": ["title", "summary", "storage"],
            "properties": { "operations": { "type": "object", "required": ["link", "read", "update", "unlink"] } }
          }
        }
      ]
    },
    "resourceOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 120 },
            "batch": { "$ref": "#/$defs/resourceBatch" },
            "destructive": { "type": "boolean" },
            "note": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "required": ["tool", "batch"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unavailable": { "type": "string", "enum": ["unsupported", "unimplemented"] },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "required": ["unavailable", "reason"]
        }
      ]
    },
    "resourceBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["array", "collection", "singleton"] },
        "input": { "type": "string", "pattern": "^/(?:[^/~]|~0|~1)+(?:/(?:[^/~]|~0|~1)+)*$", "maxLength": 500 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["mode"],
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "array" } }, "required": ["mode"] },
          "then": { "required": ["input"] }
        },
        {
          "if": { "properties": { "mode": { "const": "singleton" } }, "required": ["mode"] },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}

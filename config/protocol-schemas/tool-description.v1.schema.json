{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-slayer.local/schemas/tool-description.v1.schema.json",
  "title": "Agent Slayer Tool Description",
  "description": "The provider-owned compact routing description published in a tool's _meta[\"agent-slayer/selection\"] field. Exact execution descriptions and input/output schemas remain separate MCP tool-definition fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "enum": ["agent-slayer.tool-description"]
    },
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "description": "One or two human-authored routing sentences stating the concrete outcome, when to select the tool, and its nearest important distinction."
    },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["CREATE", "READ", "UPDATE", "DELETE", "EXECUTE"]
      }
    },
    "effectClassifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["READ-ONLY", "MUTATING", "DESTRUCTIVE", "EXTERNAL"]
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "description": "A bounded provider-owned operation list for a dispatcher tool whose generic schema hides materially different operations. Omission means the tool itself is already the routing unit.",
      "properties": {
        "exhaustive": {
          "type": "boolean",
          "description": "When true, absence from entries proves that the tool does not expose another operation in this version."
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
              "actionClasses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["CREATE", "READ", "UPDATE", "DELETE", "EXECUTE"]
                }
              },
              "effectClassifications": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["READ-ONLY", "MUTATING", "DESTRUCTIVE", "EXTERNAL"]
                }
              }
            },
            "required": ["name", "title", "summary", "actionClasses", "effectClassifications"]
          }
        }
      },
      "required": ["exhaustive", "entries"]
    }
  },
  "required": ["protocol", "version", "summary", "actionClasses", "effectClassifications"]
}

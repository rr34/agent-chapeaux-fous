{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-slayer.local/schemas/object-description.v1.schema.json",
  "title": "Agent Slayer remote Object Description",
  "description": "Provider-owned object types published on a read-only MCP tool in _meta[\"agent-slayer/objects\"]. The containing tool is the authoritative read path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "types"],
  "properties": {
    "protocol": { "const": "agent-slayer.object-description" },
    "version": { "const": 1 },
    "types": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "summary", "reference", "display", "qualifiers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$", "maxLength": 120 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 320 },
          "aliases": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "reference": { "$ref": "#/$defs/field" },
          "display": { "$ref": "#/$defs/field" },
          "qualifiers": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/field" } },
          "relationships": {
            "type": "array", "maxItems": 24,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "targetType", "summary"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                "targetType": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$", "maxLength": 120 },
                "summary": { "type": "string", "minLength": 1, "maxLength": 240 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "summary"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    }
  }
}

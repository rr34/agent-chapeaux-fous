{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-slayer.local/schemas/outcome-evidence-bindings.v1.schema.json",
  "title": "Agent Slayer outcome evidence bindings",
  "description": "Provider-owned declarations connecting exact tool-result locations to first-class objects that do or do not count as semantic outcome evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "bindings"],
  "properties": {
    "protocol": { "const": "agent-slayer.outcome-evidence-bindings" },
    "version": { "const": 1 },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "objectType", "effect", "countsTowardOutcome"],
        "allOf": [{
          "if": {
            "properties": { "effect": { "const": "supporting" } },
            "required": ["effect"]
          },
          "then": {
            "properties": { "countsTowardOutcome": { "const": false } },
            "required": ["countsTowardOutcome"]
          }
        }],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\/(?:[^~\\/]|~[01])+(?:\\/(?:\\*|(?:[^~\\/]|~[01])+))*$",
            "maxLength": 500
          },
          "objectType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
            "maxLength": 120
          },
          "effect": {
            "enum": ["created", "updated", "deleted", "unchanged", "supporting"]
          },
          "countsTowardOutcome": { "type": "boolean" },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
            "maxLength": 160
          }
        }
      }
    }
  }
}

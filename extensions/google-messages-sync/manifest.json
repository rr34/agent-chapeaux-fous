{
  "manifest_version": 3,
  "name": "Time V3 Google Messages Sync",
  "version": "0.3.2",
  "description": "Explicitly synchronize Google Messages for Web correspondence into Time V3.",
  "permissions": ["storage", "tabs", "activeTab", "alarms"],
  "host_permissions": ["https://messages.google.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Time V3 Google Messages Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://messages.google.com/web/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
